# Report and presentation folders stay local, except the four final files.
# These lines come last so that the negations override the file-type rules above.
/report/*
/presentation/*
!/report/NUSH2_Final_Report.pdf
!/report/NUSH2_Final_Report.docx
!/presentation/NUSH2_Final_Presentation.pptx
!/presentation/NUSH2_Final_Presentation.pdf
